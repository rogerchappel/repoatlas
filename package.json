{
  "name": "repoatlas",
  "version": "0.1.4",
  "description": "Local-first repository intelligence CLI and MCP server for coding agents.",
  "type": "module",
  "bin": {
    "repoatlas": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "docs/CONTEXT_PACKS.md",
    "docs/IMPACT_BRIEFS.md",
    "docs/INDEX_FORMAT.md",
    "docs/MCP.md",
    "docs/PRIVACY.md",
    "docs/schemas",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "docs/RELEASE_CHECKLIST.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "pretest": "npm run build",
    "test:social": "node --test --test-name-pattern='CLI indexes, briefs, packs, asks, and serves MCP tools' dist/tests/cli.test.js",
    "pretest:social": "npm run build",
    "docs:contract": "node --test tests/docs-contract.test.mjs",
    "smoke": "bash tests/smoke.sh",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "release:contract": "node scripts/release-contract.mjs",
    "release:contract:test": "node --test tests/release-contract.test.mjs",
    "release:dry-run": "node scripts/release-contract.mjs --pack",
    "release:check": "npm run check && npm test && npm run docs:contract && npm run smoke && npm run package:smoke && npm run release:contract:test && npm run release:contract"
  },
  "keywords": [
    "mcp",
    "code-intelligence",
    "repository",
    "agents",
    "cli",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repoatlas.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/repoatlas/issues"
  },
  "homepage": "https://github.com/rogerchappel/repoatlas#readme"
}
